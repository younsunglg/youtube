        ]
      ]
    },
    "1. 블로그 → 스크립트": {
      "main": [
        [
          {
            "node": "2. 텍스트 → 음성 (Edge TTS)",
            "type": "main",
            "index": 0
          },
          {
            "node": "4. 배경 이미지",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. 텍스트 → 음성 (Edge TTS)": {
