      ]
    },
    "3. 음성 파일 읽기": {
      "main": [
        [
          {
            "node": "5. 데이터 병합",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. 배경 이미지": {
      "main": [
        [
          {
